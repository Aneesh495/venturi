!
! Canonical FourCC atom identifiers, brand codes, handler types,
! and ISO/IEC 14496-12 sample flag bitmasks for the ISOBMFF engine.

USING: kernel math ;
IN: venturi.isobmff.constants

! Top-level and Container Boxes
CONSTANT: FOURCC_FTYP 0x66747970  ! "ftyp"
CONSTANT: FOURCC_MOOV 0x6D6F6F76  ! "moov"
CONSTANT: FOURCC_MVHD 0x6D766864  ! "mvhd"
CONSTANT: FOURCC_TRAK 0x7472616B  ! "trak"
CONSTANT: FOURCC_TKHD 0x746B6864  ! "tkhd"
CONSTANT: FOURCC_MDIA 0x6D646961  ! "mdia"
CONSTANT: FOURCC_MDHD 0x6D646864  ! "mdhd"
CONSTANT: FOURCC_HDLR 0x68646C72  ! "hdlr"
CONSTANT: FOURCC_MINF 0x6D696E66  ! "minf"
CONSTANT: FOURCC_VMHD 0x766D6864  ! "vmhd"
CONSTANT: FOURCC_SMHD 0x736D6864  ! "smhd"
CONSTANT: FOURCC_DINF 0x64696E66  ! "dinf"
CONSTANT: FOURCC_DREF 0x64726566  ! "dref"
CONSTANT: FOURCC_URL  0x75726C20  ! "url "
CONSTANT: FOURCC_STBL 0x7374626C  ! "stbl"

! Sample Table Boxes
CONSTANT: FOURCC_STSD 0x73747364  ! "stsd"
CONSTANT: FOURCC_STTS 0x73747473  ! "stts"
CONSTANT: FOURCC_CTTS 0x63747473  ! "ctts"
CONSTANT: FOURCC_STSC 0x73747363  ! "stsc"
CONSTANT: FOURCC_STSZ 0x7374737A  ! "stsz"
CONSTANT: FOURCC_STZ2 0x73747A32  ! "stz2"
CONSTANT: FOURCC_STCO 0x7374636F  ! "stco"
CONSTANT: FOURCC_CO64 0x636F3634  ! "co64"
CONSTANT: FOURCC_STSS 0x73747373  ! "stss"
CONSTANT: FOURCC_SDTP 0x73647470  ! "sdtp"

! Visual & Audio Sample Entries
CONSTANT: FOURCC_AVC1 0x61766331  ! "avc1"
CONSTANT: FOURCC_HEV1 0x68657631  ! "hev1"
CONSTANT: FOURCC_HVC1 0x68766331  ! "hvc1"
CONSTANT: FOURCC_AVCC 0x61766343  ! "avcC"
CONSTANT: FOURCC_HVCC 0x68766343  ! "hvcC"
CONSTANT: FOURCC_BTRT 0x62747274  ! "btrt"
CONSTANT: FOURCC_MP4A 0x6D703461  ! "mp4a"
CONSTANT: FOURCC_ESDS 0x65736473  ! "esds"

! Movie Extends Boxes (Fragmentation)
CONSTANT: FOURCC_MVEX 0x6D766578  ! "mvex"
CONSTANT: FOURCC_MEHD 0x6D656864  ! "mehd"
CONSTANT: FOURCC_TREX 0x74726578  ! "trex"

! Movie Fragment Boxes
CONSTANT: FOURCC_MOOF 0x6D6F6F66  ! "moof"
CONSTANT: FOURCC_MFHD 0x6D666864  ! "mfhd"
CONSTANT: FOURCC_TRAF 0x74726166  ! "traf"
CONSTANT: FOURCC_TFHD 0x74666864  ! "tfhd"
CONSTANT: FOURCC_TFDT 0x74666474  ! "tfdt"
CONSTANT: FOURCC_TRUN 0x7472756E  ! "trun"
CONSTANT: FOURCC_MDAT 0x6D646174  ! "mdat"
CONSTANT: FOURCC_STYP 0x73747970  ! "styp"
CONSTANT: FOURCC_SIDX 0x73696478  ! "sidx"
CONSTANT: FOURCC_EMSG 0x656D7367  ! "emsg"
CONSTANT: FOURCC_UDTA 0x75647461  ! "udta"
CONSTANT: FOURCC_FREE 0x66726565  ! "free"
CONSTANT: FOURCC_SKIP 0x736B6970  ! "skip"

! Brand FourCC Identifiers
CONSTANT: BRAND_ISOM 0x69736F6D  ! "isom"
CONSTANT: BRAND_ISO2 0x69736F32  ! "iso2"
CONSTANT: BRAND_ISO6 0x69736F36  ! "iso6"
CONSTANT: BRAND_MP41 0x6D703431  ! "mp41"
CONSTANT: BRAND_MP42 0x6D703432  ! "mp42"
CONSTANT: BRAND_AVC1 0x61766331  ! "avc1"
CONSTANT: BRAND_CMAF 0x636D6166  ! "cmaf"
CONSTANT: BRAND_CMFC 0x636D6663  ! "cmfc"
CONSTANT: BRAND_CMF2 0x636D6632  ! "cmf2"
CONSTANT: BRAND_DASH 0x64617368  ! "dash"
CONSTANT: BRAND_MSDH 0x6D736468  ! "msdh"
CONSTANT: BRAND_MSIX 0x6D736978  ! "msix"

! Track Handler FourCC Identifiers
CONSTANT: HANDLER_VIDE 0x76696465  ! "vide" (video)
CONSTANT: HANDLER_SOUN 0x736F756E  ! "soun" (sound / audio)
CONSTANT: HANDLER_SBTL 0x7362746C  ! "sbtl" (subtitles)
CONSTANT: HANDLER_META 0x6D657461  ! "meta" (metadata)

! Track Fragment Header (tfhd) Optional Field Flags
CONSTANT: TFHD_FLAG_BASE_DATA_OFFSET         0x000001
CONSTANT: TFHD_FLAG_SAMPLE_DESCRIPTION_INDEX 0x000002
CONSTANT: TFHD_FLAG_DEFAULT_SAMPLE_DURATION  0x000008
CONSTANT: TFHD_FLAG_DEFAULT_SAMPLE_SIZE      0x000010
CONSTANT: TFHD_FLAG_DEFAULT_SAMPLE_FLAGS     0x000020
CONSTANT: TFHD_FLAG_DURATION_IS_EMPTY        0x010000
CONSTANT: TFHD_FLAG_DEFAULT_BASE_IS_MOOF     0x020000

! Track Fragment Run (trun) Optional Field Flags
CONSTANT: TRUN_FLAG_DATA_OFFSET_PRESENT                  0x000001
CONSTANT: TRUN_FLAG_FIRST_SAMPLE_FLAGS_PRESENT           0x000004
CONSTANT: TRUN_FLAG_SAMPLE_DURATION_PRESENT              0x000100
CONSTANT: TRUN_FLAG_SAMPLE_SIZE_PRESENT                  0x000200
CONSTANT: TRUN_FLAG_SAMPLE_FLAGS_PRESENT                 0x000400
CONSTANT: TRUN_FLAG_SAMPLE_COMPOSITION_TIME_OFFSET       0x000800

! Standard Sample Flags
! Non-sync sample: bit 16 is set (0x01000000)
! Depends-on: 0x02000000 (I-frame does not depend, P/B frames do)
CONSTANT: SAMPLE_FLAG_SYNC_KEYFRAME    0x02000000  ! depends-on: does not depend
CONSTANT: SAMPLE_FLAG_NON_SYNC         0x01010000  ! is-non-sync-sample = 1
